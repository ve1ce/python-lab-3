QWidget#centralWidget,
QWidget#dashboardPage,
QWidget#historyPage,
QWidget#pageContent,
QScrollArea#pageScroll {
    background-color: #f5f6f8;
    border: none;
}

QFrame#sidebar {
    background-color: #ffffff;
    border-right: 1px solid #e5e7eb;
}

QLabel#appTitle {
    font-size: 17px;
    font-weight: 600;
    color: #1f2937;
}

QPushButton#navButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 10px 14px;
    text-align: left;
    font-size: 14px;
    color: #4b5563;
}

QPushButton#navButton:hover {
    background-color: #f3f4f6;
}

QPushButton#navButton:checked {
    background-color: #e8eef7;
    color: #315b91;
    font-weight: 600;
}

QLabel#footer {
    font-size: 11px;
    color: #9ca3af;
}

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    padding: 4px;
    color: #374151;
}

QMenuBar::item {
    padding: 6px 12px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: #e8eef7;
    border-radius: 4px;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    color: #374151;
}

QMenu::item {
    padding: 7px 25px;
}

QMenu::item:selected {
    background-color: #e8eef7;
}

QFrame#contentCard {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
}

QLabel#pageTitle {
    font-size: 26px;
    font-weight: 600;
    color: #1f2937;
}

QLabel#sectionTitle {
    font-size: 16px;
    font-weight: 600;
    color: #1f2937;
}

#practicePage QLabel#sectionTitle {
    font-size: 17px;
}

QLabel#mutedText {
    font-size: 13px;
    color: #6b7280;
}

QLabel#statValue, QLabel#resultLabel {
    font-weight: 600;
    color: #315b91;
}

QLabel#statValue {
    font-size: 28px;
}

QLabel#resultLabel {
    font-size: 22px;
}

QLabel#activityText {
    font-size: 13px;
    color: #374151;
}

QLabel#emptyMessage {
    font-size: 13px;
    color: #9ca3af;
    padding: 10px 0;
}

QLineEdit#inputField {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 5px;
    padding: 9px 11px;
    font-size: 13px;
    color: #1f2937;
}

QLineEdit#inputField:focus {
    border: 1px solid #7697bd;
}

QPushButton#primaryButton, QPushButton#deleteButton {
    border-radius: 5px;
    padding: 8px 16px;
    font-size: 13px;
}

QPushButton#primaryButton {
    background-color: #416b9b;
    border: none;
    color: #ffffff;
}

QPushButton#primaryButton:hover {
    background-color: #365a84;
}

QPushButton#deleteButton {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    color: #4b5563;
}

QPushButton#deleteButton:hover {
    background-color: #f3f4f6;
}

#practicePage QPushButton#primaryButton {
    padding: 10px 16px;
}

#practicePage QPushButton#primaryButton:disabled {
    background-color: #cbd5e1;
}

QTableWidget#dataTable {
    background-color: #ffffff;
    alternate-background-color: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 5px;
    color: #374151;
    font-size: 13px;
    selection-background-color: #e8eef7;
    selection-color: #1f2937;
}

QTableWidget#dataTable QHeaderView::section {
    background-color: #f3f4f6;
    border: none;
    border-bottom: 1px solid #e5e7eb;
    padding: 10px;
    color: #4b5563;
    font-weight: 600;
}

QLabel#wordFeedback[state="error"] {
    font-size: 12px;
    color: #b45309;
}

QLabel#wordFeedback[state="success"] {
    font-size: 12px;
    color: #347858;
}

QLabel#wordLabel {
    font-size: 30px;
    font-weight: 600;
    color: #1f2937;
    padding: 15px;
}

QLabel#feedbackText {
    font-size: 13px;
    color: #4b5563;
}

QLabel#errorText {
    font-size: 13px;
    color: #b45309;
}

QPushButton#answerButton {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 5px;
    padding: 10px;
    color: #374151;
    font-size: 14px;
    text-align: left;
}

QPushButton#answerButton:hover {
    background-color: #f3f6fa;
    border: 1px solid #7697bd;
}

QPushButton#answerButton[state="correct"] {
    background-color: #e7f3eb;
    border: 1px solid #74a789;
    color: #25603c;
}

QPushButton#answerButton[state="incorrect"] {
    background-color: #fbeaea;
    border: 1px solid #cf8888;
    color: #a13b3b;
}

QProgressBar#practiceProgress {
    background-color: #e5e7eb;
    border: none;
    border-radius: 4px;
}

QProgressBar#practiceProgress::chunk {
    background-color: #7697bd;
    border-radius: 4px;
}
